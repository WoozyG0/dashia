# ── Dash.IA — configuração ──────────────────────────────────────────────────
# Copie este arquivo para .env e ajuste. Tudo é OPCIONAL.

# IA (escolha UM dos dois caminhos):
#   1) Claude Code instalado e logado na máquina (`claude` no terminal) — deixe a
#      chave abaixo VAZIA e o Dash.IA usa a sua sessão, sem chave de API.
#   2) Chave da API Anthropic (https://console.anthropic.com) — preencha abaixo.
ANTHROPIC_API_KEY=

# Servidor
# PORT=4000
# HOST=127.0.0.1        # padrão: só a sua máquina. Use 0.0.0.0 p/ expor na rede local (sem auth!)

# Orquestração multi-agente
# DASH_ORCHESTRATE=1    # 0 = build em chamada única (mais rápido, menos profundo)
# DASH_MODEL=sonnet     # modelo padrão (sonnet | opus | haiku)
# DASH_ORCH_MODEL=      # modelo do orquestrador/revisor (default: DASH_MODEL)
# DASH_AGENT_MODEL=     # modelo dos agentes de fatia (default: DASH_MODEL)
# DASH_AGENT_CONCURRENCY=3  # agentes em paralelo
# DASH_AI_TIMEOUT=240   # teto (s) por chamada de IA
# AI_CONCURRENCY=2      # análises simultâneas aceitas pelo servidor
